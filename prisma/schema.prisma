// BlackSquare Questing Platform — data model
// See PLAN.md section 4 for the plain-English explanation of each model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
}

enum QuestStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SubmissionType {
  LINK
  TEXT
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         Role      @default(MEMBER)
  createdAt    DateTime  @default(now())

  submissions    Submission[]
  reviewed       Submission[]  @relation("Reviewer")
  pointsLedger   PointsLedger[]
}

model Quest {
  id             String         @id @default(cuid())
  title          String
  description    String
  instructions   String
  coverImage     String?
  pointValue     Int
  submissionType SubmissionType @default(LINK)
  status         QuestStatus    @default(DRAFT)
  isFeatured     Boolean        @default(false)
  category       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  submissions Submission[]
}

model Submission {
  id          String           @id @default(cuid())
  quest       Quest            @relation(fields: [questId], references: [id])
  questId     String
  user        User             @relation(fields: [userId], references: [id])
  userId      String
  content     String
  status      SubmissionStatus @default(PENDING)
  reviewer    User?            @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewerId  String?
  reviewNote  String?
  submittedAt DateTime         @default(now())
  reviewedAt  DateTime?

  pointsLedgerEntry PointsLedger?

  @@index([questId])
  @@index([userId])
  @@index([status])
}

model PointsLedger {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String     @unique
  amount       Int
  createdAt    DateTime   @default(now())

  @@index([userId])
}
